// ============================================================
// LOOKUP FUNCTION
// ============================================================

export function getDiseaseInfo(crop, prediction) {
  const cropData = cropDiseaseDatabase[crop];

  if (!cropData) {
    return {
      success: false,
      message: "Crop not supported."
    };
  }

  const disease = cropData[prediction];

  if (!disease) {
    return {
      success: false,
      crop,
      diagnosis: "Unknown",
      message:
        "The detected problem does not match a disease currently supported by this model."
    };
  }

  return {
    success: true,
    crop,
    ...disease
  };
}


// ============================================================
// PROCESS AI PREDICTION
// ============================================================

export function processPrediction(crop, prediction, confidence) {

  // Example threshold — validate/calibrate this with your model.
  const CONFIDENCE_THRESHOLD = 0.70;

  if (confidence < CONFIDENCE_THRESHOLD) {
    return {
      success: false,
      crop,
      diagnosis: "Uncertain",
      confidence: Math.round(confidence * 100),

      message:
        "I could not confidently identify the problem from this photo.",

      voiceMessage:
        "I am not confident enough to identify this problem. Please take another clear photo of the affected part of the plant."
    };
  }

  const result = getDiseaseInfo(crop, prediction);

  return {
    ...result,
    confidence: Math.round(confidence * 100)
  };
}


// ============================================================
// SIMPLE COST CALCULATOR
// ============================================================

export function calculateTreatmentCost({
  pricePerUnit,
  unitsNeeded,
  laborCost = 0,
  transportCost = 0
}) {

  const inputCost = pricePerUnit * unitsNeeded;

  return {
    inputCost,
    laborCost,
    transportCost,
    totalCost: inputCost + laborCost + transportCost
  };
}